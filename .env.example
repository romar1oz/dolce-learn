# --- Dolce Learn: пример конфигурации. Скопируйте в .env и задайте свои значения. ---
# База данных PostgreSQL
DATABASE_URL=postgresql+psycopg://dolce:dolce_dev_password@127.0.0.1:5433/dolce_learn
# Секрет для подписи JWT. В production — длинная случайная строка (openssl rand -hex 32)
JWT_SECRET=change-me-in-production-please-use-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Разрешённые источники CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Каталог хранения загруженных файлов
STORAGE_DIR=../storage
# Ограничения размера загрузок, МБ
MAX_VIDEO_MB=1024
MAX_DOCUMENT_MB=100
# true — cookie только по HTTPS (обязательно в production)
COOKIE_SECURE=false
ENVIRONMENT=development
# Демо-пароль seed-скрипта (только локальная демонстрация)
SEED_DEMO_PASSWORD=DolceDemo2026!
